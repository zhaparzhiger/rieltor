# Скопируйте в .env рядом с docker-compose.yml и заполните.
# .env лежит в .gitignore — в репозиторий он не попадёт.

# ── Домен ────────────────────────────────────────────────────────────────────
# Перед запуском A-запись eppb-portal.online → IP сервера должна уже резолвиться,
# иначе Let's Encrypt не выдаст сертификат.
APP_DOMAIN=eppb-portal.online

# ── Gemini ───────────────────────────────────────────────────────────────────
# Вариант 1 (проще): ключ из Google AI Studio.
GEMINI_USE_VERTEX=0
GEMINI_API_KEY=

# Вариант 2: сервисный аккаунт Vertex — тот же, что у aether и peakcut.
# Тогда GEMINI_USE_VERTEX=1, GEMINI_API_KEY оставить пустым,
# а в GOOGLE_SERVICE_ACCOUNT_JSON вставить всё содержимое google-key.json
# ОДНОЙ строкой (без переносов).
# GEMINI_USE_VERTEX=1
# GOOGLE_CLOUD_PROJECT=gen-lang-client-0537370402
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"gen-lang-client-0537370402",...}

GEMINI_MODEL=gemini-2.5-flash

# ── Необязательное ───────────────────────────────────────────────────────────
# Своя сессия Krisha, чтобы телефоны подтягивались автоматически.
# DevTools → Network → любой запрос к krisha.kz → заголовок Cookie целиком.
KRISHA_COOKIE=
