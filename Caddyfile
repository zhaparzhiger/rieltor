# Домен берётся из APP_DOMAIN, но со значением по умолчанию: пустая переменная
# ломает разбор конфига, а не просто выключает строку.
#
# Почту для Let's Encrypt намеренно не задаём — без неё сертификат тоже выдаётся,
# теряются только письма об истечении. Нужна — добавьте первым блоком:
#   { email вы@почта }

{$APP_DOMAIN:peakcut.online} {
	encode zstd gzip
	reverse_proxy rieltor:3007
}

# Запасной вход по http://<IP сервера>. Нужен, пока не настроен DNS: без него
# сайт недоступен вообще, потому что блок выше отвечает только на своё имя.
:80 {
	encode zstd gzip
	reverse_proxy rieltor:3007
}
