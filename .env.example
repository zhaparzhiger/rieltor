# Вариант 1 — ключ Google AI Studio
GEMINI_API_KEY=

# Вариант 2 — Vertex AI по сервисному аккаунту
GEMINI_USE_VERTEX=1
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

GEMINI_MODEL=gemini-2.5-flash

# Необязательно. Krisha показывает телефон только вошедшим в аккаунт.
# Сюда можно вставить свою строку Cookie из браузера (DevTools → Network → любой
# запрос к krisha.kz → заголовок Cookie), тогда номера будут подтягиваться
# вашим же аккаунтом. Без этого приложение покажет только превью «+7 701 …».
KRISHA_COOKIE=
